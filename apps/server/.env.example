# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.
#
# Nothing in this file is ever sent to the browser. The client receives only
# what an API route explicitly returns; there is no NEXT_PUBLIC_ secret, and
# adding one is a review blocker.

# --- Required -------------------------------------------------------------
# Signing key for access tokens. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Rotate by setting AUTH_JWT_SECRET_PREVIOUS to the old value for one deploy so
# in-flight tokens keep verifying, then remove it.
AUTH_JWT_SECRET=change-me-to-at-least-32-random-characters
# AUTH_JWT_SECRET_PREVIOUS=

# Separate secret for refresh tokens, so leaking one class of token does not
# compromise the other.
AUTH_REFRESH_SECRET=change-me-too-at-least-32-random-characters

# --- Database -------------------------------------------------------------
# sqlite | postgres. Only sqlite has an implementation today; see docs/BACKEND.md.
DATABASE_DRIVER=sqlite
DATABASE_URL=file:./data/farmrise.sqlite

# --- Optional -------------------------------------------------------------
NODE_ENV=development
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Access token lifetime in seconds. Short by design; refresh handles longevity.
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
# Requests per minute per IP for unauthenticated routes.
RATE_LIMIT_ANON_PER_MINUTE=30
RATE_LIMIT_USER_PER_MINUTE=120

# Required only when running npm run db:seed.
SEED_USER_PASSWORD=

# Public browser analytics identifiers. These are compiled into the Vite bundle.
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
VITE_GLITCH_TITLE_ID=
VITE_GLITCH_WEB_TRACKING_TOKEN=

# Glitch runtime title token from Reports > Tokens. Do not use a deploy, hosting,
# MCP, admin, or web-tracking token here.
VITE_GLITCH_TITLE_TOKEN=
VITE_GLITCH_BUILD_TYPE=production
VITE_APP_VERSION=0.1.0

# Playwright-only gate. A real release must leave this unset/0.
VITE_ANALYTICS_TEST_MODE=0
